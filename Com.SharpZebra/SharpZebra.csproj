<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net20</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>1.2.0</Version>
    <PackageReleaseNotes>v1.2.0: Added FontStore to upload TrueType (.TTF) fonts to the printer, and FontDelete to remove them. Added Query to IZebraPrinter to read replies from the printer (NetworkPrinter and USBPrinter; not supported by SpoolPrinter). Added DirectoryList to list the files on a printer drive and HostStatus to read the printer's state (paper out, paused, head up, ribbon out, print mode and more). Network queries apply the timeout to connecting as well as reading, and USB reads no longer block when the printer does not reply.</PackageReleaseNotes>
    <PackageId>SharpZebra.rkone</PackageId>
    <Authors>rkone</Authors>
    <Company>rkone</Company>
    <Product>SharpZebra</Product>
    <Description>A .net library that simplifies printing to Zebra printers in their native EPL2/ZPL languages without needing to know EPL2 or ZPL.  
NEW: Check out SharpZebraStandard - a NetStandard2.0 version for those using only networked label printers.</Description>
    <PackageTags>Barcode Zebra Label Printer</PackageTags>
    <Copyright></Copyright>
    <SignAssembly>true</SignAssembly>
    <DelaySign>false</DelaySign>
    <AssemblyOriginatorKeyFile>SharpZebraSigning.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
 
</Project>